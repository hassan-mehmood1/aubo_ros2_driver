controller_manager:
  ros__parameters:
    update_rate: 200  # Hz  250

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    joint_trajectory_controller:
      type: joint_trajectory_controller/JointTrajectoryController

    forward_command_controller_position:
      type: forward_command_controller/ForwardCommandController

joint_trajectory_controller:
  ros__parameters:
    joints:
      - shoulder_joint
      - upperArm_joint
      - foreArm_joint  #foreArm_joint
      - wrist1_joint
      - wrist2_joint
      - wrist3_joint
    command_interfaces:
      - position
    state_interfaces:
      - position
      - velocity
    state_publish_rate: 100.0 #100
    action_monitor_rate: 20.0
    allow_partial_joints_goal: false
    constraints:
 
     stopped_velocity_tolerance: 0.02
     goal_time: 2.0

      shoulder_joint:
        goal: 0.002
      upperArm_joint:
        goal: 0.002
      foreArm_joint:
        goal: 0.002
      wrist1_joint:
        goal: 0.002
      wrist2_joint:
        goal: 0.002
      wrist3_joint:
        goal: 0.002

         open_loop_control: false
    set_last_command_interface_value_as_state_on_activation: false

   
 

forward_command_controller_position:
  ros__parameters:
    joints:
      - shoulder_joint
      - upperArm_joint
      - foreArm_joint
      - wrist1_joint
      - wrist2_joint
      - wrist3_joint
    interface_name: position
